# Copy the variables you need into your shell or your hosting provider's settings.
# Everything has a local-dev default in src/main/resources/application.yml.

# JDBC URL of your MySQL database
DATABASE_URL=jdbc:mysql://localhost:3306/teachnet?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DATABASE_USERNAME=teachnet
DATABASE_PASSWORD=teachnet

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Comma-separated list of frontend URLs allowed to call the API (wildcards allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# Creates an admin account on startup if it doesn't exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Fill an empty database with sample teachers, schools, jobs and posts
SEED_DEMO_DATA=false
