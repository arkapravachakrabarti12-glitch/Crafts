<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MpinApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_ink</item>
        <item name="colorPrimaryContainer">@color/accent_dark</item>
        <item name="colorOnPrimaryContainer">#CCFBF1</item>
        <item name="colorSecondary">@color/indigo</item>
        <item name="colorOnSecondary">#1E1B4B</item>
        <item name="colorSecondaryContainer">@color/indigo_dark</item>
        <item name="colorOnSecondaryContainer">#E0E7FF</item>
        <item name="colorTertiary">@color/indigo</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface_low</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">#202A4D</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Mpin.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Mpin.SectionTitle" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
